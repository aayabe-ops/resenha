{
  "name": "@resenha/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm dev-vars && mkdir -p .wrangler/dev-assets && wrangler dev --assets .wrangler/dev-assets",
    "typegen": "wrangler types --strict-vars=false",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dev-vars": "[ -f .dev.vars ] || cp .dev.vars.example .dev.vars",
    "start": "pnpm dev-vars && wrangler dev"
  },
  "dependencies": {
    "@resenha/db": "workspace:^",
    "@resenha/shared": "workspace:^",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.6",
    "vitest": "~5.0.5",
    "wrangler": "^4.151.3"
  }
}
